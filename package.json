{
  "name": "bloom-api",
  "version": "1.0.0",
  "description": "API REST per il negozio Bloom: Node.js, Express e PostgreSQL",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:setup": "node --env-file=.env scripts/setup-db.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "supertest": "^7.0.0"
  }
}
